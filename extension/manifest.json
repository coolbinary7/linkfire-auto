{
  "manifest_version": 3,
  "name": "Linkfire Auto Pre-save",
  "version": "1.8.0",
  "description": "Crée des liens pre-save Linkfire en série et prépare les sorties dans RWS (dates, pays, post release, market scope, rush).",
  "permissions": [
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://app.linkfire.com/*",
    "https://apps.rws.umusic.net/*",
    "https://*.umusic.net/*",
    "https://*.umgapps.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Linkfire Auto",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.linkfire.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}